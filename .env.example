# ============================================================================
# ALFIYA TAMBOLI – MEHENDI WEBSITE & MINI CMS ENVIRONMENT VARIABLES
# Copy this file to `.env` for local development or configure in Vercel.
# NEVER commit your actual `.env` file or real secrets to GitHub.
# ============================================================================

# Server Port (used for local node server.js)
PORT=8080

# Admin Authentication
# Default demo username: admin
# Default demo password (for development only): Alfiya@Demo2026
# Generate a new salt and scrypt hash for production using:
#   node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');console.log('SALT='+s+'\nHASH='+c.scryptSync('YourNewPassword',s,64).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=7f4e9a1b2c3d4e5f6a7b8c9d0e1f2a3b
ADMIN_PASSWORD_HASH=1682df777d57ad770887b6b111a5b425c06987870ae489d177bb5f7f341793782cf98874f362cc83eb83a773988b21bc9db42ed42c15c1e29ac97494f134856e

# Secret key used to sign HTTP-only admin session cookies (use 32+ random characters in production)
SESSION_SECRET=change-this-to-a-long-random-secret-string-in-production-2026

# Supabase Configuration (Recommended for Vercel Production Deployment)
# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided, the CMS stores
# all database records in Supabase PostgreSQL and uploaded images in Supabase Storage.
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=alfiya-media
