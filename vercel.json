{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{lib/**,data/**,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?__route=/api/:path*"
    },
    {
      "source": "/admin/login",
      "destination": "/api/index.js?__route=/admin/login"
    },
    {
      "source": "/admin",
      "destination": "/api/index.js?__route=/admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/index.js?__route=/admin"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.js?__route=/uploads/:path*"
    }
  ]
}
